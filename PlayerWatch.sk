#  ██╗    ██╗ █████╗ ████████╗ ██████╗██╗  ██╗
#  ██║    ██║██╔══██╗╚══██╔══╝██╔════╝██║  ██║
#  ██║ █╗ ██║███████║   ██║   ██║     ███████║
#  ██║███╗██║██╔══██║   ██║   ██║     ██╔══██║
#  ╚███╔███╔╝██║  ██║   ██║   ╚██████╗██║  ██║
#   ╚══╝╚══╝ ╚═╝  ╚═╝   ╚═╝    ╚═════╝╚═╝  ╚═╝
#
# Sistema de observação para operadores.
# Requer Skript 2.16.2
#
# Arquivo:
# plugins/Skript/scripts/PlayerWatch.sk
# ============================================================


# ============================================================
#                     CONFIGURAÇÃO
# ============================================================

options:

    # >> ATIVAR O SISTEMA <<
    enabled: true

    # >> AVISAR NO CONSOLE AO CARREGAR <<
    show-load-message: true

    # >> PERMITIR SOMENTE OPERADORES <<
    operator-only: true

    # >> RESTAURAR AUTOMATICAMENTE SE O ALVO SAIR <<
    stop-on-target-quit: true


# ============================================================
#                     CARREGAMENTO
# ============================================================

on load:

    if {@show-load-message} is true:
        send "&8[&bPlayerWatch&8] &aSistema carregado com sucesso!" to console


# ============================================================
#                     COMANDO /WATCH
# ============================================================

command /watch [<player>] [<text>]:
    permission: playerwatch.use
    permission message: &cVocê não possui permissão para usar este comando.
    executable by: players
    description: Observa a câmera de outro jogador.

    trigger:

        if {@enabled} is false:
            send "&cO PlayerWatch está desativado."
            stop

        if {@operator-only} is true:
            if player is not op:
                send "&cVocê não possui permissão para usar o PlayerWatch."
                stop

        # Sair da observação

        if arg-1 is not set:

            if {playerwatch::%player%::target} is set:

                set {_old-location} to {playerwatch::%player%::location}
                set {_old-gamemode} to {playerwatch::%player%::gamemode}

                execute console command "spectate"

                wait 1 tick

                set player's gamemode to {_old-gamemode}
                teleport player to {_old-location}

                send "&8[&bPlayerWatch&8] &aVocê saiu da observação."

                delete {playerwatch::%player%::*}

            else:

                send "&8[&bPlayerWatch&8] &7Você não está observando ninguém."

            stop

        if arg-1 is not set:
            stop

        if arg-1 is a player:
            if "%arg-1%" is "status":
                if {playerwatch::%player%::target} is set:
                    send "&8[&bPlayerWatch&8] &fObservando: &b%{playerwatch::%player%::target}%"
                else:
                    send "&8[&bPlayerWatch&8] &7Você não está observando ninguém."
                stop

        # Verificar alvo

        set {_target} to arg-1

        if {_target} is dead:
            send "&8[&bPlayerWatch&8] &cNão é possível observar um jogador morto."
            stop

        if {_target} is player:
            if {_target} is player:
                if {_target} is player:
                    if {_target} is player:
                        if {_target} is player:
                            if {_target} is player:
                                # alvo válido

        if {_target} is player:
            if {_target} is player:
                if {_target} is player:
                    if {_target} is player:
                        if "%{_target}%" is "%player%":
                            send "&cVocê não pode observar a si mesmo."
                            stop

        # Trocar observação

        if {playerwatch::%player%::target} is set:

            if "%{playerwatch::%player%::target}%" is "%{_target}%":
                send "&8[&bPlayerWatch&8] &7Você já está observando &b%{_target}%&7."
                stop

            set {_old-location} to {playerwatch::%player%::location}
            set {_old-gamemode} to {playerwatch::%player%::gamemode}

            execute console command "spectate"

            wait 1 tick

            set player's gamemode to {_old-gamemode}
            teleport player to {_old-location}

            delete {playerwatch::%player%::*}

        # Salvar estado

        set {playerwatch::%player%::location} to player's location
        set {playerwatch::%player%::gamemode} to player's gamemode
        set {playerwatch::%player%::target} to {_target}

        set player's gamemode to spectator

        send "&8[&bPlayerWatch&8] &7Conectando à câmera de &b%{_target}%&7..."

        wait 2 ticks

        execute console command "spectate %{_target}% %player%"

        wait 1 tick

        send "&8[&bPlayerWatch&8] &aObservando &b%{_target}%&a."
        send "&8[&bPlayerWatch&8] &7Use &f/watchstop &7para sair."


# ============================================================
#                  ALVO DESCONECTOU
# ============================================================

on quit:

    if {@stop-on-target-quit} is true:

        loop all players:

            if {playerwatch::%loop-player%::target} is set:

                if "%{playerwatch::%loop-player%::target}%" is "%player%":

                    set {_staff} to loop-player
                    set {_location} to {playerwatch::%{_staff}%::location}
                    set {_gamemode} to {playerwatch::%{_staff}%::gamemode}

                    execute console command "spectate"

                    wait 1 tick

                    set {_staff}'s gamemode to {_gamemode}
                    teleport {_staff} to {_location}

                    send "&8[&bPlayerWatch&8] &cO jogador observado saiu do servidor." to {_staff}
                    send "&8[&bPlayerWatch&8] &7Observação encerrada automaticamente." to {_staff}

                    delete {playerwatch::%{_staff}%::*}

    if {playerwatch::%player%::target} is set:
        delete {playerwatch::%player%::*}


# ============================================================
#                    SEGURANÇA NO JOIN
# ============================================================

on join:

    if {playerwatch::%player%::*} is set:

        delete {playerwatch::%player%::*}

        send "&8[&bPlayerWatch&8] &7Sessão de observação anterior foi encerrada."


# ============================================================
#                  BLOQUEAR INTERAÇÃO
# ============================================================

on damage:

    if {playerwatch::%victim%::target} is set:
        cancel event


# ============================================================
#                  LIMPEZA DE COMANDO
# ============================================================

command /watchstop:
    permission: playerwatch.use
    permission message: &cVocê não possui permissão para usar este comando.
    executable by: players
    description: Encerra uma observação do PlayerWatch.

    trigger:

        if player is not op:
            send "&cVocê não possui permissão para usar este comando."
            stop

        if {playerwatch::%player%::target} is not set:
            send "&8[&bPlayerWatch&8] &7Você não está observando ninguém."
            stop

        set {_location} to {playerwatch::%player%::location}
        set {_gamemode} to {playerwatch::%player%::gamemode}

        execute console command "spectate"

        wait 1 tick

        set player's gamemode to {_gamemode}
        teleport player to {_location}

        send "&8[&bPlayerWatch&8] &aObservação encerrada."

        delete {playerwatch::%player%::*}